# Local secrets. vercel dev reads .env.local — GITHUB_TOKEN lives there, and
# committing it would hand anyone who reads the repo write access to it.
.env
.env.local
.env*.local

# Vercel's local build cache
.vercel

# OS and editor noise
.DS_Store
Thumbs.db

# Claude local configuration and temporary files
.claude/settings.json
.claude/scheduled_tasks.lock

.vercel
.env*

# Dependencies
node_modules/

# Generated redesign assets and reports
redesign-100/output/
redesign-100/work/raw/
redesign-100/work/*.log
redesign-100/work/*.txt
redesign-100/work/*.json

# Generated screenshots
redesign-100/integration/shots/

# Original AI-generated source images (keep locally, do not push)
ai-generated/comfyui-raw/
