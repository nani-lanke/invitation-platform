# Local secrets. vercel dev reads .env.local — GITHUB_TOKEN lives there, and
# committing it would hand anyone who reads the repo write access to it.
.env
.env.local
.env*.local

# Vercel's local build cache
.vercel

# OS and editor noise
.DS_Store
Thumbs.db

# Claude local configuration and temporary files
.claude/settings.json
.claude/scheduled_tasks.lock

.vercel
.env*

# Installed dependencies
node_modules/

# Temporary browser automation captures
.playwright-mcp/

# Large local AI source and working files
/ai-generated/comfyui-raw/
/lineart-work/raw/
/redesign-100/output/
/redesign-100/work/
/node_modules/
/.playwright-mcp/
