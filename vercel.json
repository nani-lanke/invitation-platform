{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,

  "functions": {
    "api/publish.js": { "includeFiles": "js/**", "maxDuration": 60 },
    "api/upload.js": { "maxDuration": 30 },
    "api/invite.js": { "maxDuration": 30 },
    "api/check.js": { "includeFiles": "js/**" },
    "api/cleanup.js": { "maxDuration": 60 }
  },

  "crons": [
    { "path": "/api/cleanup", "schedule": "30 21 * * *" }
  ],

  "rewrites": [
    {
      "source": "/invitations/:file(.*)",
      "destination": "/api/invite?dir=invitations&file=:file"
    },
    {
      "source": "/invitation_card/:file(.*)",
      "destination": "/api/invite?dir=invitation_card&file=:file"
    }
  ],

  "headers": [
    {
      "source": "/api/(publish|check)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
